# Copy to .env (gitignored) and run with: uv run --env-file .env <command>
# Never put real secrets in this file.

# Event store (Dev B): sqlite for dev/tests; keewano is a stub until M3b
SWARMSHIELD_STORE=sqlite
SWARMSHIELD_SQLITE_PATH=.data/keewano.sqlite3
SWARMSHIELD_REJECTS_PATH=.data/rejects.jsonl
SWARMSHIELD_TENANTS=customer-a,customer-b,customer-c

# Keewano (M3b, not used yet): one project per tenant, e.g. customer-a=<project-id>
KEEWANO_PROJECT_IDS=
